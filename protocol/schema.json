{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zero-protocol-4",
  "title": "Z.E.R.O. protocol 4",
  "description": "One JSON object a line over the server's Unix socket (~/.zero/run/zero.sock): a request, then its reply; session/watch and session/list with watch stream events. Each request names its message in `message`.",
  "x-protocol": 4,
  "oneOf": [
    {
      "$ref": "#/$defs/server.hello"
    },
    {
      "$ref": "#/$defs/server.stop"
    },
    {
      "$ref": "#/$defs/session.send"
    },
    {
      "$ref": "#/$defs/session.continue"
    },
    {
      "$ref": "#/$defs/session.stop"
    },
    {
      "$ref": "#/$defs/session.list"
    },
    {
      "$ref": "#/$defs/session.read"
    },
    {
      "$ref": "#/$defs/session.watch"
    },
    {
      "$ref": "#/$defs/session.mark_seen"
    },
    {
      "$ref": "#/$defs/session.rename"
    },
    {
      "$ref": "#/$defs/session.archive"
    },
    {
      "$ref": "#/$defs/session.unarchive"
    },
    {
      "$ref": "#/$defs/session.delete"
    },
    {
      "$ref": "#/$defs/session.compact"
    },
    {
      "$ref": "#/$defs/session.set"
    },
    {
      "$ref": "#/$defs/job.list"
    },
    {
      "$ref": "#/$defs/job.stop"
    },
    {
      "$ref": "#/$defs/rounds.list"
    },
    {
      "$ref": "#/$defs/rounds.stop"
    },
    {
      "$ref": "#/$defs/grant.list"
    },
    {
      "$ref": "#/$defs/grant.forget"
    },
    {
      "$ref": "#/$defs/model.list"
    },
    {
      "$ref": "#/$defs/model.features"
    },
    {
      "$ref": "#/$defs/model.server.list"
    },
    {
      "$ref": "#/$defs/model.server.probe"
    },
    {
      "$ref": "#/$defs/model.server.connect"
    },
    {
      "$ref": "#/$defs/model.server.disconnect"
    },
    {
      "$ref": "#/$defs/setting.list"
    },
    {
      "$ref": "#/$defs/setting.set"
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "ok",
        "error"
      ]
    },
    "server.hello": {
      "type": "object",
      "description": "The server's versions and what keeps it busy; a client's first look.",
      "properties": {
        "message": {
          "const": "server/hello"
        },
        "protocol": {
          "type": "integer",
          "description": "the client's protocol; the server refuses another"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "server.hello.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "protocol": {
          "type": "integer"
        },
        "build": {
          "type": "string"
        },
        "pid": {
          "type": "integer"
        },
        "started_at": {
          "type": "number"
        },
        "busy_with": {
          "type": "object"
        },
        "last_session": {
          "anyOf": [
            {
              "type": "string",
              "description": "a session's id"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ok"
      ]
    },
    "server.stop": {
      "type": "object",
      "description": "Stop the server; while anything runs it says what, unless forced.",
      "properties": {
        "message": {
          "const": "server/stop"
        },
        "force": {
          "type": "boolean"
        },
        "reason": {
          "enum": [
            "stopped",
            "restart"
          ]
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "server.stop.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "stopping": {
          "type": "boolean"
        },
        "busy_with": {
          "type": "object"
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.send": {
      "type": "object",
      "description": "A message to a session, or to a new one: a turn starts, or it steers or queues behind the running one, or it answers the open ask.",
      "properties": {
        "message": {
          "const": "session/send"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string"
        },
        "session": {
          "anyOf": [
            {
              "type": "string",
              "description": "a session's id"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string",
          "description": "who sends it: a client's own name"
        },
        "thinking_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "a new session's thinking effort: off, low, high or max"
        },
        "reply_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "the open ask's id: this text answers it"
        },
        "workspace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "a new session's folder"
        },
        "when_busy": {
          "enum": [
            "steer",
            "queue"
          ]
        },
        "choice": {
          "enum": [
            "yes",
            "session",
            "saved",
            "no"
          ],
          "description": "one of the open ask's choices, as picked at its box"
        },
        "rounds": {
          "type": "boolean",
          "description": "the message is to be worked on in rounds: ZERO is told, and its estimate goes to the user"
        }
      },
      "required": [
        "message",
        "id",
        "text",
        "source"
      ],
      "additionalProperties": false
    },
    "session.send.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "admitted": {
          "type": "boolean"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        },
        "handled_as": {
          "enum": [
            "started",
            "steered",
            "queued",
            "reply"
          ]
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.continue": {
      "type": "object",
      "description": "A turn that ended without an answer goes on, with no new message.",
      "properties": {
        "message": {
          "const": "session/continue"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        },
        "source": {
          "type": "string",
          "description": "who sends it: a client's own name"
        }
      },
      "required": [
        "message",
        "id",
        "session",
        "source"
      ],
      "additionalProperties": false
    },
    "session.continue.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "admitted": {
          "type": "boolean"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        },
        "handled_as": {
          "enum": [
            "started",
            "steered",
            "queued",
            "reply"
          ]
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.stop": {
      "type": "object",
      "description": "Stop a session's running turn; what it hadn't taken comes back.",
      "properties": {
        "message": {
          "const": "session/stop"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        },
        "source": {
          "type": "string",
          "description": "who sends it: a client's own name"
        }
      },
      "required": [
        "message",
        "id",
        "session",
        "source"
      ],
      "additionalProperties": false
    },
    "session.stop.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "stopped": {
          "type": "boolean"
        },
        "withdrawn": {
          "type": "array"
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.list": {
      "type": "object",
      "description": "The sessions, each with its open ask; with `watch`, the list again at each change (archived ones left out).",
      "properties": {
        "message": {
          "const": "session/list"
        },
        "archived": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "only the archived (true), the others (false), or all (null)"
        },
        "workspace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "only this folder's"
        },
        "watch": {
          "type": "boolean"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "session.list.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "one row a session"
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.list.event": {
      "type": "object",
      "description": "one event a line, until a bye",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "the whole list"
        },
        "bye": {
          "type": "string"
        }
      }
    },
    "session.read": {
      "type": "object",
      "description": "A session's records: those after a seq, or the newest `limit` (null: all; 0: none), before `before`; and what its next turn runs with.",
      "properties": {
        "message": {
          "const": "session/read"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        },
        "after": {
          "type": "integer"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "message",
        "session"
      ],
      "additionalProperties": false
    },
    "session.read.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "the log's records"
        },
        "earlier_count": {
          "type": "integer"
        },
        "runs_with": {
          "type": "object",
          "description": "what its next turn runs with: mode, model, workspace, thinking_effort, judge_model (null: the session's model) and judge_thinking_effort"
        },
        "context": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "tokens": {
                  "type": "integer"
                },
                "line": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cached_share": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "description": "the context's tokens as the latest call saw them or a compaction left them, the line it is kept under, and the share of that call's prompt the cache served"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.watch": {
      "type": "object",
      "description": "A session's records after a seq, then each new one as it comes.",
      "properties": {
        "message": {
          "const": "session/watch"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        },
        "after": {
          "type": "integer"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "message",
        "session"
      ],
      "additionalProperties": false
    },
    "session.watch.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.watch.event": {
      "type": "object",
      "description": "one event a line, until a bye",
      "properties": {
        "record": {
          "type": "object"
        },
        "settled": {
          "type": "object"
        },
        "draft": {
          "type": "object"
        },
        "withdrawn": {
          "type": "object"
        },
        "earlier_count": {
          "type": "integer"
        },
        "context": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "tokens": {
                  "type": "integer"
                },
                "line": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cached_share": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "description": "the context's tokens as the latest call saw them or a compaction left them, the line it is kept under, and the share of that call's prompt the cache served"
            },
            {
              "type": "null"
            }
          ]
        },
        "bye": {
          "type": "string"
        }
      }
    },
    "session.mark_seen": {
      "type": "object",
      "description": "Mark a session read up to a seq, for the lists' news marks.",
      "properties": {
        "message": {
          "const": "session/mark_seen"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "message",
        "session",
        "seq"
      ],
      "additionalProperties": false
    },
    "session.mark_seen.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.rename": {
      "type": "object",
      "description": "Give a session a title.",
      "properties": {
        "message": {
          "const": "session/rename"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "message",
        "session",
        "title"
      ],
      "additionalProperties": false
    },
    "session.rename.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.archive": {
      "type": "object",
      "description": "Archive a session: out of the list, kept.",
      "properties": {
        "message": {
          "const": "session/archive"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        }
      },
      "required": [
        "message",
        "session"
      ],
      "additionalProperties": false
    },
    "session.archive.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.unarchive": {
      "type": "object",
      "description": "Bring an archived session back to the list.",
      "properties": {
        "message": {
          "const": "session/unarchive"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        }
      },
      "required": [
        "message",
        "session"
      ],
      "additionalProperties": false
    },
    "session.unarchive.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.delete": {
      "type": "object",
      "description": "Delete a session: its files to the desktop's trash or ZERO's.",
      "properties": {
        "message": {
          "const": "session/delete"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        }
      },
      "required": [
        "message",
        "session"
      ],
      "additionalProperties": false
    },
    "session.delete.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "trash": {
          "type": "string"
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.compact": {
      "type": "object",
      "description": "Compact a session's context: at once when it rests, before the next step when its turn runs.",
      "properties": {
        "message": {
          "const": "session/compact"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        }
      },
      "required": [
        "message",
        "session"
      ],
      "additionalProperties": false
    },
    "session.compact.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "compacting": {
          "type": "string",
          "enum": [
            "now",
            "before_next_step"
          ]
        }
      },
      "required": [
        "ok"
      ]
    },
    "session.set": {
      "type": "object",
      "description": "Change a session's mode, model, workspace, thinking effort or judge from its next turn.",
      "properties": {
        "message": {
          "const": "session/set"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        },
        "mode": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "thinking_effort": {
          "type": "string"
        },
        "judge_model": {
          "type": "string",
          "description": "empty: the session's own model"
        },
        "judge_thinking_effort": {
          "type": "string"
        }
      },
      "required": [
        "message",
        "session"
      ],
      "additionalProperties": false
    },
    "session.set.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "set": {
          "type": "object"
        },
        "next_turn": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ]
    },
    "job.list": {
      "type": "object",
      "description": "A session's background jobs, ended ones too; with none, every running job.",
      "properties": {
        "message": {
          "const": "job/list"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "job.list.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "one row a job, its state in words in `state_text`"
        }
      },
      "required": [
        "ok"
      ]
    },
    "job.stop": {
      "type": "object",
      "description": "Stop a background job.",
      "properties": {
        "message": {
          "const": "job/stop"
        },
        "job": {
          "type": "string"
        }
      },
      "required": [
        "message",
        "job"
      ],
      "additionalProperties": false
    },
    "job.stop.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "stopped": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ]
    },
    "rounds.list": {
      "type": "object",
      "description": "A session's work in rounds, ended runs too; with none, every open one.",
      "properties": {
        "message": {
          "const": "rounds/list"
        },
        "session": {
          "type": "string",
          "description": "a session's id"
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "rounds.list.reply": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "one row a run, in a line in `summary`"
        }
      },
      "required": [
        "ok"
      ]
    },
    "rounds.stop": {
      "type": "object",
      "description": "Stop work in rounds: no next round starts; a round under way ends its turn.",
      "properties": {
        "message": {
          "const": "rounds/stop"
        },
        "rounds": {
          "type": "string"
        }
      },
      "required": [
        "message",
        "rounds"
      ],
      "additionalProperties": false
    },
